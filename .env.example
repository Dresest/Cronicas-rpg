VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICABLE

# Estas variables se configuran PRIVADAMENTE en Vercel. No use prefijo VITE_.
# Clave de servidor con rol service_role; nunca en frontend, repositorio ni logs.
SUPABASE_SERVICE_ROLE_KEY=
AI_GENERATION_ENABLED=false
VITE_AI_GENERATION_ENABLED=false
AI_GATEWAY_MODEL=alibaba/qwen-3-32b
# Configurar AI_GATEWAY_API_KEY como secreto en Vercel, o usar OIDC en Vercel.
